# Vercel > Project Settings > Environment Variables
PUBLIC_BASE_URL=https://SEU-PROJETO.vercel.app
MCP_AUTH_MODE=oauth
MCP_ADMIN_PASSWORD=SUBSTITUIR_POR_SENHA_FORTE
MCP_OAUTH_SECRET=SUBSTITUIR_POR_SEGREDO_ALEATORIO_64_CHARS
MCP_WRITE_SECRET=SUBSTITUIR_POR_OUTRO_SEGREDO_ALEATORIO_64_CHARS
# Credenciais do app privado RD Station Marketing
RD_CLIENT_ID=
RD_CLIENT_SECRET=
# Token inicial da autorização RD: armazenamento persistente será obrigatório na renovação
RD_ACCESS_TOKEN=
RD_REFRESH_TOKEN=
# Upstash Redis REST (isolado apenas para a Riole)
RD_TOKEN_STORE_REST_URL=
RD_TOKEN_STORE_REST_TOKEN=
RD_TOKEN_STORE_KEY=riole:rd:oauth
